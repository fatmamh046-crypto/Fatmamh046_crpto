<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Ahmed Website</title>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        scroll-behavior: smooth;
    }

    body {
        font-family: Arial, sans-serif;
        background: #f5f7fa;
        color: #333;
    }

    /* الشريط */
    nav {
        background: #173b6c;
        padding: 18px;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    nav a {
        color: white;
        text-decoration: none;
        margin: 0 12px;
        font-weight: bold;
    }

    nav a:hover {
        color: #ffd166;
    }

    /* الرئيسية */
    #home {
        min-height: 500px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        background: linear-gradient(135deg, #173b6c, #3498db);
        color: white;
        padding: 30px;
    }

    #home h1 {
        font-size: 45px;
        margin-bottom: 15px;
    }

    #home p {
        font-size: 21px;
    }

    .button {
        display: inline-block;
        margin-top: 25px;
        padding: 13px 28px;
        background: #ffd166;
        color: #173b6c;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
    }

    /* الأقسام */
    section {
        max-width: 1000px;
        margin: 40px auto;
        padding: 50px 25px;
        background: white;
        border-radius: 15px;
        text-align: center;
    }

    section h2 {
        color: #173b6c;
        font-size: 32px;
        margin-bottom: 25px;
    }

    /* عني */
    .about-text {
        font-size: 19px;
        line-height: 1.8;
    }

    /* المهارات */
    .skills {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .skill {
        background: #e8f1ff;
        padding: 15px 25px;
        border-radius: 10px;
        color: #173b6c;
        font-weight: bold;
    }

    /* الخدمات */
    .services {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .service {
        width: 270px;
        padding: 25px;
        background: #f5f7fa;
        border-radius: 12px;
    }

    .service h3 {
        color: #173b6c;
        margin-bottom: 12px;
    }

    /* المعرض */
    .gallery {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .gallery img {
        width: 250px;
        height: 180px;
        object-fit: cover;
        border-radius: 12px;
    }

    /* التواصل */
    .contact p {
        margin: 10px;
        font-size: 18px;
    }

    .contact a {
        display: inline-block;
        margin-top: 15px;
        padding: 12px 25px;
        background: #173b6c;
        color: white;
        text-decoration: none;
        border-radius: 8px;
    }

    /* أسفل الموقع */
    footer {
        background: #173b6c;
        color: white;
        text-align: center;
        padding: 25px;
        margin-top: 40px;
    }

    /* الموبايل */
    @media (max-width: 600px) {

        nav a {
            display: inline-block;
            margin: 6px;
        }

        #home h1 {
            font-size: 32px;
        }

        .service {
            width: 100%;
        }

        .gallery img {
            width: 100%;
            height: 200px;
        }
    }
</style>

</head><body><!-- الشريط -->
<nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#skills">Skills</a>
    <a href="#services">Services</a>
    <a href="#gallery">Gallery</a>
    <a href="#contact">Contact</a>
</nav>

<!-- الرئيسية -->
<section id="home">
    <h1>Welcome to Ahmed's Website</h1>

    <p>
        Professional Personal Website
    </p>

    <a class="button" href="#contact">
        Contact Me
    </a>
</section>

<!-- عني -->
<section id="about">
    <h2>About Me</h2>

    <p class="about-text">
        My name is Ahmed Mohamed.
        I am interested in web design and technology.
        I am always learning new skills and improving myself.
    </p>
</section>

<!-- المهارات -->
<section id="skills">
    <h2>My Skills</h2>

    <div class="skills">

        <div class="skill">
            HTML
        </div>

        <div class="skill">
            CSS
        </div>

        <div class="skill">
            Web Design
        </div>

        <div class="skill">
            English
        </div>

    </div>
</section>

<!-- الخدمات -->
<section id="services">
    <h2>My Services</h2>

    <div class="services">

        <div class="service">
            <h3>Web Design</h3>
            <p>
                Creating modern and simple websites.
            </p>
        </div>

        <div class="service">
            <h3>Personal Websites</h3>
            <p>
                Creating personal pages and portfolios.
            </p>
        </div>

        <div class="service">
            <h3>Online Services</h3>
            <p>
                Helping people with basic websites.
            </p>
        </div>

    </div>
</section>

<!-- المعرض -->
<section id="gallery">
    <h2>Gallery</h2>

    <div class="gallery">

        <img src="https://picsum.photos/400/300?random=1" alt="Gallery image">

        <img src="https://picsum.photos/400/300?random=2" alt="Gallery image">

        <img src="https://picsum.photos/400/300?random=3" alt="Gallery image">

    </div>
</section>

<!-- التواصل -->
<section id="contact">
    <h2>Contact Me</h2>

    <div class="contact">

        <p>Email: ahmed@example.com</p>

        <p>Phone: 01000000000</p>

        <a href="mailto:ahmed@example.com">
            Send Email
        </a>

    </div>
</section>

<!-- أسفل الموقع -->
<footer>
    <p>
        © 2026 Ahmed Website
    </p>
</footer>

</body></html>
